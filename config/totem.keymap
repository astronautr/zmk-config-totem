#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

&sk {
    release-after-ms = <60000>;
};

/ {
    combos {
        compatible = "zmk,combos";

        combo_esc {
            timeout-ms = <50>;
            key-positions = <0 1>;
            bindings = <&kp ESC>;
            layers = <0>;
        };
    };

    behaviors {
        // Wellum-style one-shot sticky modifiers. A second press releases a
        // modifier explicitly, while holding it still works like a normal mod.
        m_release_key_twice: m_release_key_twice {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <
                &macro_release
                &macro_param_1to1 &kp 0
                &macro_param_1to1 &kp 0
            >;
        };

        m_press_key_twice: m_press_key_twice {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <
                &macro_press
                &macro_param_1to1 &kp 0
                &macro_param_1to1 &kp 0
                &macro_pause_for_release
                &macro_tap
                &macro_param_1to1 &m_release_key_twice 0
            >;
        };

        sticky_forever: sticky_forever {
            compatible = "zmk,behavior-sticky-key";
            #binding-cells = <1>;
            bindings = <&m_press_key_twice>;
            release-after-ms = <4294967295>;
            ignore-modifiers;
        };

        cm_gui: cm_gui {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&sticky_forever LGUI>, <&m_release_key_twice LGUI>;
            mods = <(MOD_LGUI)>;
            keep-mods = <(MOD_LGUI)>;
        };

        cm_alt: cm_alt {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&sticky_forever LALT>, <&m_release_key_twice LALT>;
            mods = <(MOD_LALT)>;
            keep-mods = <(MOD_LALT)>;
        };

        cm_ctrl: cm_ctrl {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&sticky_forever LCTRL>, <&m_release_key_twice LCTRL>;
            mods = <(MOD_LCTL)>;
            keep-mods = <(MOD_LCTL)>;
        };

        cm_sft: cm_sft {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&sticky_forever LSHIFT>, <&m_release_key_twice LSHIFT>;
            mods = <(MOD_LSFT)>;
            keep-mods = <(MOD_LSFT)>;
        };

        // Keep Ctrl/Cmd pressed while the layer key is held, so repeated taps
        // walk through browser tabs or macOS applications.
        m_hold_mod_press_key: m_hold_mod_press_key {
            compatible = "zmk,behavior-macro-two-param";
            #binding-cells = <2>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <
                &macro_press
                &macro_param_1to1 &kp 0
                &macro_tap
                &macro_param_2to1 &kp 0
            >;
        };

        tabber: tabber {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&m_hold_mod_press_key LCTRL TAB>, <&kp TAB>;
            mods = <(MOD_LCTL)>;
            keep-mods = <(MOD_LCTL)>;
        };

        swapper_mac: swapper_mac {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&m_hold_mod_press_key LGUI TAB>, <&kp TAB>;
            mods = <(MOD_LGUI)>;
            keep-mods = <(MOD_LGUI)>;
        };

        // Layer access without hold-tap timing. Pressing a layer key also
        // commits queued sticky modifiers and releases them with the layer.
        la: la {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <
                &macro_tap
                &kp 0
                &macro_press
                &macro_param_1to1 &mo 0
                &macro_pause_for_release
                &macro_release
                &macro_param_1to1 &mo 0
                &kp LSHFT
                &kp LCTRL
                &kp LALT
                &kp LGUI
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        num_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "BASE";
            bindings = <
&kp Q          &kp W          &kp E          &kp R          &kp T              &kp Y          &kp U          &kp I          &kp O          &kp P
&kp A          &kp S          &kp D          &kp F          &kp G              &kp H          &kp J          &kp K          &kp L          &kp FSLH
&kp COMMA      &kp Z          &kp X          &kp C          &kp V          &kp B  &kp N          &kp M          &kp SEMI       &kp LBKT       &kp RBKT       &kp DOT
                                                &kp CAPS       &kp SPACE     &la 1              &la 2          &kp BSPC       &kp RET
            >;
        };

        nav_layer {
            display-name = "NAV";
            bindings = <
&tabber      &swapper_mac &kp LG(GRAVE)  &kp LC(UP)     &kp ESC            &kp ESC        &kp HOME       &kp END        &kp BSPC       &kp DEL
&cm_gui      &cm_alt      &cm_ctrl       &cm_sft        &kp RET            &kp RET        &kp LEFT       &kp DOWN       &kp UP         &kp RIGHT
&kp LG(A)    &kp LC(LG(LEFT)) &kp LC(LG(RIGHT)) &kp LG(C) &kp LG(V)   &kp TAB &kp TAB        &kp PG_UP      &kp PG_DN      &kp LG(Z)      &kp LS(LG(Z))   &kp LG(X)
                                                &mo 4          &trans       &trans             &trans         &trans         &trans
            >;
        };

        sym_layer {
            display-name = "SYM";
            bindings = <
&kp N1         &kp N2         &kp N3         &kp N4         &kp N5             &kp N6         &kp N7         &kp N8         &kp N9         &kp N0
&kp GRAVE      &kp SQT        &kp MINUS      &kp EQUAL      &kp BSLH           &kp RA(H)      &cm_sft        &cm_ctrl       &cm_alt        &cm_gui
&kp RA(T)      &kp RA(I)      &kp RA(M)      &kp RA(COMMA)  &kp RA(DOT)   &kp RA(MINUS) &kp RA(J) &kp RA(LBKT) &kp LS(RA(LBKT)) &kp LS(RA(RBKT)) &kp RA(RBKT) &kp RA(SPACE)
                                                &trans         &trans       &trans             &trans         &trans         &trans
            >;
        };

        num_layer {
            display-name = "NUM";
            bindings = <
&kp N1         &kp N2         &kp N3         &kp N4         &kp N5             &kp N6         &kp N7         &kp N8         &kp N9         &kp N0
&cm_gui        &cm_alt        &cm_ctrl       &cm_sft        &kp F11            &kp F12        &cm_sft        &cm_ctrl       &cm_alt        &cm_gui
&trans         &kp F1         &kp F2         &kp F3         &kp F4        &kp F5 &kp F6         &kp F7         &kp F8         &kp F9         &kp F10        &trans
                                                &trans         &trans       &trans             &trans         &trans         &trans
            >;
        };

        system_layer {
            display-name = "SYS";
            bindings = <
&bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4      &out OUT_TOG &none        &none        &sys_reset   &bootloader
&kp C_PREV   &kp C_VOL_DN &kp C_MUTE   &kp C_VOL_UP &kp C_NEXT      &kp RA(G)    &none        &none        &none        &none
&trans       &none        &none        &none        &none       &none &none        &none        &none        &none        &bt BT_CLR    &trans
                                                &trans         &trans       &trans             &trans         &trans         &trans
            >;
        };
    };
};
