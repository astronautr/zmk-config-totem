#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

&sk { release-after-ms = <60000>; };

/ {
    combos {
        compatible = "zmk,combos";

        combo_esc {
            timeout-ms = <50>;
            key-positions = <0 1>;
            bindings = <&kp ESC>;
            layers = <0>;
        };
    };

    behaviors {
        // Wellum-style one-shot sticky modifiers. A second press releases a
        // modifier explicitly, while holding it still works like a normal mod.

        m_release_key_twice: m_release_key_twice {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_release>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
        };

        m_press_key_twice: m_press_key_twice {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_press>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER &macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_tap>,
                <&macro_param_1to1 &m_release_key_twice MACRO_PLACEHOLDER>;
        };

        sticky_forever: sticky_forever {
            compatible = "zmk,behavior-sticky-key";
            #binding-cells = <1>;
            bindings = <&m_press_key_twice>;
            release-after-ms = <4294967295>;
            ignore-modifiers;
        };

        cm_gui: cm_gui {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&sticky_forever LGUI>, <&m_release_key_twice LGUI>;

            mods = <(MOD_LGUI)>;
            keep-mods = <(MOD_LGUI)>;
        };

        cm_alt: cm_alt {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&sticky_forever LALT>, <&m_release_key_twice LALT>;

            mods = <(MOD_LALT)>;
            keep-mods = <(MOD_LALT)>;
        };

        cm_ctrl: cm_ctrl {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&sticky_forever LCTRL>, <&m_release_key_twice LCTRL>;

            mods = <(MOD_LCTL)>;
            keep-mods = <(MOD_LCTL)>;
        };

        cm_sft: cm_sft {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&sticky_forever LSHIFT>, <&m_release_key_twice LSHIFT>;

            mods = <(MOD_LSFT)>;
            keep-mods = <(MOD_LSFT)>;
        };

        // Keep Ctrl/Cmd pressed while the layer key is held, so repeated taps
        // walk through browser tabs or macOS applications.

        m_hold_mod_press_key: m_hold_mod_press_key {
            compatible = "zmk,behavior-macro-two-param";
            #binding-cells = <2>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_press>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_tap>,
                <&macro_param_2to1 &kp MACRO_PLACEHOLDER>;
        };

        tabber: tabber {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&m_hold_mod_press_key LCTRL TAB>, <&kp TAB>;

            mods = <(MOD_LCTL)>;
            keep-mods = <(MOD_LCTL)>;
        };

        swapper_mac: swapper_mac {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&m_hold_mod_press_key LGUI TAB>, <&kp TAB>;

            mods = <(MOD_LGUI)>;
            keep-mods = <(MOD_LGUI)>;
        };

        // Layer access without hold-tap timing. Pressing a layer key also
        // commits queued sticky modifiers and releases them with the layer.

        la: la {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_tap>,
                <&kp 0>,
                <&macro_press>,
                <&macro_param_1to1 &mo MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &mo MACRO_PLACEHOLDER &kp LSHFT &kp LCTRL &kp LALT &kp LGUI>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        num_layer {
            if-layers = <1 1>;
            then-layer = <1>;
        };
    };

    macros {
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "BASE";
            bindings = <
           &kp Q  &kp W  &kp E      &kp R         &kp T           &kp Y        &kp U          &kp I       &kp O     &kp P
           &kp A  &kp S  &kp D      &kp F         &kp G           &kp H        &kp J          &kp K       &kp L     &kp FSLH
&lt 1 TAB  &kp Z  &kp X  &kp C      &kp V         &kp B           &kp N        &kp M          &kp SEMI    &kp LBKT  &kp RBKT  &kp RIGHT_SHIFT
                         &kp LCTRL  &kp LEFT_ALT  &kp LEFT_GUI    &lt 2 SPACE  &kp RIGHT_ALT  &kp RETURN
            >;
        };

        layer_1 {
            bindings = <
        &kp ESCAPE      &kp UP_ARROW    &trans     &trans         &trans          &kp SINGLE_QUOTE  &kp GRAVE  &kp EQUAL  &kp PLUS  &kp BACKSLASH
        &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT  &kp BACKSPACE  &trans          &kp DELETE        &trans     &trans     &trans    &trans
&trans  &trans          &trans          &trans     &trans         &trans          &trans            &trans     &trans     &trans    &trans         &trans
                                        &trans     &trans         &kp KP_COMMA    &kp KP_DOT        &trans     &trans
            >;
        };

        layer_2 {
            bindings = <
        &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp N5         &kp NUMBER_6  &kp N7         &kp N8        &kp N9                &kp N0
        &kp EXCL      &kp AT_SIGN   &kp HASH      &kp DOLLAR    &kp PERCENT    &kp CARET     &kp AMPERSAND  &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&trans  &trans        &trans        &trans        &trans        &trans         &trans        &trans         &trans        &trans                &trans                 &trans
                                    &trans        &trans        &trans         &trans        &trans         &trans
            >;
        };
    };
};
